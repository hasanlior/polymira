{
  "name": "polymira",
  "productName": "POLYMIRA",
  "version": "0.1.1",
  "description": "Universal gaming console experience for PC: a controller-first, XMB-style frontend that organizes and launches games across platforms.",
  "main": "./out/main/index.js",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win && node scripts/shortcut.cjs dist",
    "vmp:sign": "python -m castlabs_evs.vmp sign-pkg node_modules/electron/dist",
    "postbuild": "node scripts/shortcut.cjs",
    "i18n:check": "node scripts/i18n-check.cjs"
  },
  "dependencies": {
    "koffi": "2.9.2"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "github:castlabs/electron-releases#v45.2.1+wvcus",
    "electron-builder": "25.1.8",
    "electron-vite": "2.3.0",
    "hls.js": "1.5.17",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  },
  "build": {
    "appId": "io.github.polymira.app",
    "productName": "POLYMIRA",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-${arch}-${os}.${ext}"
    },
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/v"
    },
    "afterPack": "scripts/vmp-sign.cjs",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "POLYMIRA",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "copyright": "Copyright (c) 2026 hasanlior",
    "electronDist": "node_modules/electron/dist",
    "electronVersion": "45.2.1",
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "author": "hasanlior",
  "repository": {
    "type": "git",
    "url": "https://github.com/hasanlior/polymira.git"
  }
}
